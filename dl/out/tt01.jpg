//# sourceURL=wpascript-js-after</script> <script id="tdr-wait-kr-script-js-after">document.addEventListener('click', function(e){
    const tab = e.target.closest('.tdrw-tab-btn');
    if(tab){
        const board = tab.closest('.tdrw-board');
        board.querySelectorAll('.tdrw-tab-btn').forEach(btn => btn.classList.remove('is-active'));
        board.querySelectorAll('.tdrw-panel').forEach(panel => panel.classList.remove('is-active'));
        tab.classList.add('is-active');
        const target = board.querySelector('#' + tab.dataset.target);
        if(target){ target.classList.add('is-active'); }
    }

    const filter = e.target.closest('.tdrw-filter-btn');
    if(filter){
        const panel = filter.closest('.tdrw-panel, .tdrw-single');
        panel.querySelectorAll('.tdrw-filter-btn').forEach(btn => btn.classList.remove('is-active'));
        filter.classList.add('is-active');
        const mode = filter.dataset.filter || 'all';
        const rows = panel.querySelectorAll('tbody tr[data-status]');
        rows.forEach(row => {
            if(mode === 'all'){ row.style.display = ''; return; }
            row.style.display = row.dataset.status === mode ? '' : 'none';
        });
    }
});

document.addEventListener('input', function(e){
    if(!e.target.classList.contains('tdrw-search')) return;
    const panel = e.target.closest('.tdrw-panel, .tdrw-single');
    const term = (e.target.value || '').toLowerCase().trim();
    const rows = panel.querySelectorAll('tbody tr[data-name]');
    rows.forEach(row => {
        const name = row.dataset.name || '';
        row.style.display = name.includes(term) ? '' : 'none';
    });
});
//# sourceURL=tdr-wait-kr-script-js-after</script> <script id="usj-wait-kr-script-js-after">document.addEventListener('click', function(e){
    const filter = e.target.closest('.usjw-filter-btn');
    if(filter){
        const panel = filter.closest('.usjw-single');
        panel.querySelectorAll('.usjw-filter-btn').forEach(btn => btn.classList.remove('is-active'));
        filter.classList.add('is-active');
        const mode = filter.dataset.filter || 'all';
        const rows = panel.querySelectorAll('tbody tr[data-status]');
        rows.forEach(row => {
            if(mode === 'all'){ row.style.display = ''; return; }
            row.style.display = row.dataset.status === mode ? '' : 'none';
        });
    }
});

document.addEventListener('input', function(e){
    if(!e.target.classList.contains('usjw-search')) return;
    const panel = e.target.closest('.usjw-single');
    const term = (e.target.value || '').toLowerCase().trim();
